# Copy to .env; the API loads it with `uvicorn --env-file .env`. Every setting is optional.

# Database. Unset: a local SQLite file, backend/quiz.db.
# Postgres in Docker (`docker compose up -d db` from the repo root):
# DATABASE_URL=postgresql+psycopg://quiz:quiz@localhost:5432/quiz

# Google sign-in web client id. Unset: the login page offers a demo account.
# GOOGLE_CLIENT_ID=
# ALLOW_DEV_LOGIN=false

# Claude API key for the dashboard analysis. Unset: a template summary is shown.
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5-5

# Production only: send the session cookie over HTTPS only.
# COOKIE_SECURE=true
